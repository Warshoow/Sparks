# ===========================================
# LLM Provider
# ===========================================
# "openai" (cloud, paid) or "ollama" (local, free)
LLM_PROVIDER=openai

# OpenAI (only needed when LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# Ollama (only needed when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434/v1

# Model overrides (leave empty for provider defaults)
# OpenAI defaults: gpt-4o-mini | Ollama defaults: llama3.3 / llava
LLM_CHAT_MODEL=
LLM_VISION_MODEL=

# ===========================================
# Transcription Provider
# ===========================================
# "openai" (Whisper API, paid) or "faster-whisper" (local, free)
TRANSCRIPTION_PROVIDER=openai
FASTER_WHISPER_MODEL=small
FASTER_WHISPER_DEVICE=cpu
FASTER_WHISPER_COMPUTE_TYPE=int8

# ===========================================
# Social Media Credentials
# ===========================================
# Instagram
INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password

# Facebook
FACEBOOK_ACCESS_TOKEN=your_facebook_access_token

# LinkedIn
LINKEDIN_EMAIL=your_linkedin_email
LINKEDIN_PASSWORD=your_linkedin_password

# Beeper
BEEPER_ACCESS_TOKEN=your_beeper_token

# ===========================================
# Infrastructure
# ===========================================
# Database
DATABASE_URL=sqlite:///./social_archive.db

# Redis (for caching)
REDIS_URL=redis://localhost:6379/0

# ===========================================
# Processing Options
# ===========================================
ENABLE_TRANSCRIPTION=true
ENABLE_VISUAL_ANALYSIS=true
ENABLE_AUTO_TAGGING=true

# Storage
ARCHIVE_PATH=./archives
MEDIA_PATH=./media
